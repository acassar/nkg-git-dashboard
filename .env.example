# ============================================================================
# Configuration GitLab — copie ce fichier en `.env` puis renseigne tes valeurs.
# NE COMMITE JAMAIS le fichier `.env` (il est déjà dans .gitignore).
# ============================================================================

# URL de ton instance GitLab entreprise (sans slash final)
# Ex: https://gitlab.mon-entreprise.com
VITE_GITLAB_URL=https://gitlab.example.com

# Personal / Group / Project Access Token avec le scope `read_api`.
# Toute variable renseignée ici est PRIORITAIRE : elle verrouille le champ
# correspondant dans l'interface (config manuelle par fichier). Les champs
# laissés vides restent modifiables dans le panneau Réglages.
VITE_GITLAB_TOKEN=

# ID(s) ou chemin(s) de groupe/projets à monitorer, séparés par des virgules.
# - Groupe :  mon-groupe/mon-sous-groupe   (ou l'ID numérique)
# - Projet :  mon-groupe/mon-projet         (ou l'ID numérique)
# Laisse vide pour tout configurer depuis l'interface.
VITE_GITLAB_GROUPS=
VITE_GITLAB_PROJECTS=

# Passe à "true" seulement pour un GitLab de dev avec un certificat auto-signé.
VITE_GITLAB_INSECURE_TLS=false
